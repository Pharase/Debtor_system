# Copy to .env (git-ignored) and fill in. Paths can be absolute or relative to this folder.

# SQLite database with the debtor tables (default: database/Debtor_system.db)
DEBTOR_DB_PATH=database/Debtor_system.db
# Folder that holds the summary_data_file_*.xlsx transaction exports (default: data/)
TRANSACTION_FOLDER=data
# Optional: use a server database instead of SQLite for SQLAlchemy, e.g. mysql+pymysql://USER:PASSWORD@HOST:3306/Debtor_system
DATABASE_URL=
# Prefix your source system puts in front of column names (leave empty if none).
# When set, old column names in the database are renamed once (a .bak copy is saved first).
LEGACY_COLUMN_PREFIX=
